+    async def _page_has_prompt_editor(self, page: Page) -> bool:
+        """Return True when a visible Flow prompt surface exists on this page."""
+        if page.is_closed():
+            return False
+        for selector in PROMPT_SELECTORS:
+            try:
+                locator = page.locator(selector)
+                count = min(await locator.count(), 20)
+                for index in range(count):
+                    item = locator.nth(index)
+                    if not await item.is_visible():
+                        continue
+                    box = await item.bounding_box()
+                    if box and box["width"] >= 180 and box["height"] >= 20:
+                        return True
+            except Exception:
+                continue
+        return False
+
+    async def _adopt_existing_project_page(self) -> bool:
+        """Switch to an already-open Flow project instead of getting stuck on gallery."""
+        assert self.context is not None
+        candidates = [
+            page for page in self.context.pages
+            if not page.is_closed() and "labs.google/fx" in page.url and "/flow" in page.url
+        ]
+        for page in reversed(candidates):
+            if await self._page_has_prompt_editor(page):
+                self.page = page
+                await page.bring_to_front()
+                return True
+        project_pages = [page for page in candidates if "/project/" in page.url]
+        if project_pages:
+            self.page = project_pages[-1]
+            await self.page.bring_to_front()
+            return True
+        return False
